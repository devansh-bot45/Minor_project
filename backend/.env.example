# Copy to backend/.env — every value is optional for the core app.
PORT=5001
DEBUG=false
# SQLite file for session history (default: backend/data/har.db)
# HAR_DB_PATH=data/har.db

# ── Optional cloud features (all three required to enable them) ──
# MONGODB_URI=mongodb+srv://...
# JWT_SECRET=<long random string>
# GOOGLE_CLIENT_ID=<your Google OAuth client id>
# GEMINI_API_KEY=<your Gemini key, needed only for AI report generation>
