# Copy to frontend/.env — all optional.
# Where the Vite dev server proxies /api requests (default http://localhost:5001)
# BACKEND_URL=http://localhost:5001
# Only for a separately hosted frontend (e.g. Vercel) talking to a deployed backend:
# VITE_API_BASE_URL=https://your-backend.example.com
# Only for the optional Google sign-in / AI reports:
# VITE_GOOGLE_CLIENT_ID=<your Google OAuth client id>
